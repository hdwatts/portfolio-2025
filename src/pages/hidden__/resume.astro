---
// Source for public/resume.pdf (rendered by `npm run resume:pdf`).
export const prerender = true;
import "../../styles/global.css";
import data from "../../../data/portfolio.json";
import resume from "../../../data/resume.json";
type Extra = { heading: string; year: string; highlights: string[] };
const extras: Record<string, Extra> = resume.projectHighlights;
const bullet = `<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>`;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<title>{data.person.name} — Resume</title>
		<meta name="robots" content="noindex" />
		<style>
			@page { size: Letter; margin: 0.4in; }
			body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
		</style>
	</head>
	<body class="bg-white text-[#111] font-sans">
		<header class="flex flex-row justify-between border-b-2 px-8 py-4">
			<div class="flex items-center gap-4">
				<img src={data.person.headshot.src} alt={data.person.headshot.alt} class="h-16 w-16 rounded-full" />
				<div class="flex flex-col">
					<span class="text-xl font-semibold">{data.person.name}</span>
					<span class="font-light">{resume.title}</span>
				</div>
			</div>
			<div class="flex flex-col justify-center text-xs">
				<a href={`mailto:${resume.contact.email}`} class="border-b px-4 underline">{resume.contact.email}</a>
				<span class="px-4">{resume.contact.phone}</span>
			</div>
		</header>

		<section class="flex flex-col gap-2 px-8 py-4">
			<h2 class="text-lg font-semibold">Employment History</h2>
			{
				data.experience.map((job) => (
					<div class="flex flex-col gap-2 text-sm">
						<div class="text-base font-bold">{job.company}</div>
						<div class="flex justify-between">
							<span class="font-semibold">{job.role}</span>
							<span class="italic">{job.period}</span>
						</div>
						{job.highlights.map((h) => (
							<div class="flex gap-4">
								<div class="pt-1" set:html={bullet} />
								<div>{h}</div>
							</div>
						))}
					</div>
				))
			}
		</section>

		<section class="flex flex-col gap-2 px-8 py-4">
			<h2 class="text-lg font-semibold">Projects</h2>
			{
				data.projects.map((p) => {
					const extra = extras[p.id];
					return (
						<div class="flex flex-col gap-2 text-sm">
							<div class="text-base font-bold">{extra?.heading ?? `${p.name} - ${p.tagline}`}</div>
							<div class="flex justify-between">
								<a href={p.url} class="font-semibold text-blue-600 underline">{p.url.replace(/^https?:\/\/(www\.)?/, "")}</a>
								<span class="italic">{extra?.year ?? p.year}</span>
							</div>
							{(extra?.highlights ?? p.description.slice(0, 1)).map((h) => (
								<div class="flex gap-4">
									<div class="pt-1" set:html={bullet} />
									<div>{h}</div>
								</div>
							))}
						</div>
					);
				})
			}
		</section>

		<section class="flex flex-col gap-2 px-8 py-4 text-sm">
			<h2 class="text-lg font-semibold">Professional Skills</h2>
			<div class="font-semibold">Technical Skills</div>
			<div class="flex flex-wrap gap-4">{resume.technicalSkills.map((s) => <span>{s}</span>)}</div>
			<div class="font-semibold">Soft Skills</div>
			<div class="flex flex-wrap gap-4">{data.skills.soft.map((s) => <span>{s}</span>)}</div>
		</section>
	</body>
</html>
