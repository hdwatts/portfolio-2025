---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import data from "../../data/portfolio.json";
import { listDesigns } from "../../redesign/lib/paths.mjs";

type Design = {
	date: string;
	legacy?: boolean;
	url: string | null;
	variants?: Record<string, string>;
	screenshots: { desktop?: string; mobile?: string };
	costUsd?: number;
	model?: string | null;
	note?: string;
};

const designs = (listDesigns() as Design[]).slice().reverse();
const latest = designs.find((d) => d.url && !d.legacy)?.date;
const fmt = (d: string) =>
	new Date(`${d}T12:00:00Z`).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" });
const label = (k: keyof typeof data.labels) => data.labels[k][0];
---

<Layout title={label("nav.history")} description={data.meta.description}>
	<main class="mx-auto max-w-6xl px-4 py-12 sm:px-8">
		<header class="mb-12 flex flex-wrap items-end justify-between gap-4 border-b border-white/15 pb-6">
			<div>
				<a href="/" class="text-muted font-mono text-sm hover:text-paper">← {label("nav.home")}</a>
				<h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">{label("nav.history")}</h1>
				<p class="text-muted mt-2 max-w-xl">
					A new design every week, generated by {designs.find((d) => d.model)?.model ?? "Gemini"} from the same data.
				</p>
			</div>
			<span class="text-muted font-mono text-sm">{designs.length} designs</span>
		</header>

		{designs.length === 0 && <p class="text-muted">No designs yet.</p>}

		<ol class="grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
			{
				designs.map((d) => (
					<li class="group flex flex-col gap-3">
						<a
							href={d.url ?? undefined}
							class:list={[
								"relative block aspect-[16/10] overflow-hidden rounded-lg bg-white/5 ring-1 ring-white/10 transition",
								d.url && "hover:ring-paper/60",
							]}
							aria-label={`${fmt(d.date)}`}
						>
							{d.screenshots.desktop && (
								<img
									src={d.screenshots.desktop}
									alt=""
									loading="lazy"
									class="h-full w-full object-cover object-top transition duration-500 group-hover:scale-[1.02]"
								/>
							)}
							{d.date === latest && (
								<span class="bg-paper text-ink absolute top-3 left-3 rounded-full px-2.5 py-0.5 font-mono text-xs">
									{label("misc.present")}
								</span>
							)}
						</a>
						<div class="flex items-baseline justify-between gap-2">
							<time datetime={d.date} class="font-mono text-sm">
								{fmt(d.date)}
							</time>
							{d.url && (
								<a href={d.url} class="text-muted font-mono text-xs hover:text-paper">
									{label("action.visit")} →
								</a>
							)}
						</div>
						{d.legacy && d.note && <p class="text-muted text-sm">{d.note}</p>}
						{d.variants && (
							<dl class="text-muted grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-xs">
								{Object.entries(d.variants).map(([k, v]) => (
									<>
										<dt class="font-mono uppercase opacity-70">{k}</dt>
										<dd>{v}</dd>
									</>
								))}
							</dl>
						)}
					</li>
				))
			}
		</ol>
	</main>
</Layout>
