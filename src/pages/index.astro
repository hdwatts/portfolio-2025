---
// Fallback home page, shown only until the first weekly design is published.
// After build, redesign/finalize-site.mjs replaces this page with the latest design.
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import data from "../../data/portfolio.json";
---

<Layout>
	<main class="mx-auto flex max-w-2xl flex-col gap-10 px-6 py-16">
		<header class="flex items-center gap-6">
			<img src={data.person.headshot.src} alt={data.person.headshot.alt} class="h-24 w-24 rounded-full" />
			<div>
				<h1 class="text-2xl font-semibold">{data.person.name}</h1>
				{data.person.headline.map((h) => <p class="text-muted">{h}</p>)}
			</div>
		</header>
		<p>{data.person.summary}</p>
		<nav class="flex flex-wrap gap-4 underline">
			{data.person.links.map((l) => <a href={l.url}>{l.label}</a>)}
			<a href="/history">{data.labels["nav.history"][0]}</a>
		</nav>
	</main>
</Layout>
