---
import Analytics from "@vercel/analytics/astro";
import "../styles/global.css";
import data from "../../data/portfolio.json";

type Props = { title?: string; description?: string; noindex?: boolean };
const { title, description = data.meta.description, noindex = false } = Astro.props;
const siteTitle = title ? `${title} | ${data.meta.siteTitle}` : data.meta.siteTitle;
const ogImage = new URL(data.meta.ogImage, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1" />
		<link rel="icon" href="/favicon.ico" />
		<title>{siteTitle}</title>
		<meta name="description" content={description} />
		<meta name="author" content={data.person.name} />
		{noindex && <meta name="robots" content="noindex" />}
		<meta property="og:type" content="website" />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={siteTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<slot name="head" />
	</head>
	<body class="bg-ink text-paper min-h-dvh font-sans antialiased">
		<slot />
		<Analytics />
	</body>
</html>
